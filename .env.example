# Kalshi API credentials
KALSHI_API_KEY_ID=your-api-key-id-here
KALSHI_PRIVATE_KEY_PATH=./bitcoin-key.pem
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_TAKER_FEE=0.07
KALSHI_MAKER_FEE=0.0175

# Underlyings
ENABLE_BTC=true
ENABLE_ETH=true

# Strategy
TRADING_MODE=live
MIN_EDGE=0.05
USE_DRIFT=false
DRIFT_LOOKBACK_DAYS=30
MIN_T_HOURS=1.0
VOL_SHORT_DAYS=7
VOL_LONG_DAYS=30
VOL_SAFETY_MARGIN=1.05
MAX_VOL_RATIO=2.5
MIN_BID_ASK_SPREAD=0.0
MAX_BID_ASK_SPREAD=0.12
MAX_BID_ASK_PCT_SPREAD=0.20
MAX_LAST_PRICE_DIVERGENCE=0.20
THEO_PROB_BAND_MIN=0.20
THEO_PROB_BAND_MAX=0.80
MAX_SIGMA_DISTANCE=2.0
MAX_CHAIN_BREAK_PCT=0.10
IMBALANCE_SCORE_WEIGHT=0.03
EDGE_LEAK_LOOKBACK_FILLS=50
EDGE_HURDLE_BUFFER=0.02
SETTLED_MAE_LOOKBACK_TRADES=30
DEFAULT_EXPECTED_SLIPPAGE=0.015
DEFAULT_UNCERTAINTY_PENALTY=0.02
MAX_DEPTH_SLIPPAGE_PER_CONTRACT=0.02
LIQUIDITY_ENTRY_MULTIPLIER=5.0
ORDERBOOK_DEPTH=20
DATA_STALE_AFTER_SEC_KRAKEN=20
DATA_STALE_AFTER_SEC_KALSHI=20
DATA_STALE_AFTER_SEC_DERIBIT=120
LIVE_MIN_REQUIRED_EDGE=0.06
COLD_START_MIN_EDGE=0.06
LIVE_MIN_FILL_HISTORY=8
LIVE_MIN_SETTLED_HISTORY=10
LIVE_GUARD_LOOKBACK_FILLS=20
LIVE_GUARD_LOOKBACK_SETTLED=20
LIVE_HALT_MAX_AVG_REALIZED_EDGE=0.0
LIVE_HALT_MAX_SETTLED_MAE=0.20
LIVE_SKIP_DEGRADED_ASSETS=true
BUCKET_EDGE_MIN_TRADES=8
BUCKET_EDGE_LOOKBACK_DAYS=21
BUCKET_EDGE_MIN_AVG_REALIZED=0.0
MAKER_FILL_LOOKBACK_ATTEMPTS=40
MAKER_FILL_MIN_ATTEMPTS=8
DEFAULT_MAKER_FILL_PROB=0.50
MAKER_MISS_PENALTY=0.01

# Risk
DAILY_SPEND_PCT=0.15
DAILY_SPEND_FLOOR=5.0
MAX_CONTRACTS_PER_MARKET=15
MAX_POSITIONS=5
MAX_SYMBOL_DAILY_SPEND_PCT=0.08
MAX_SYMBOL_POSITIONS=3
KELLY_FRACTION=0.30
MAX_DRAWDOWN_PCT=0.20
BANKROLL_FRACTION=0.40
CORRELATION_DISCOUNT_FACTOR=0.85

# Implied vol calibration
IV_CALIBRATION_MIN_OBS=10
IV_SAFETY_MARGIN_MIN=1.00
IV_SAFETY_MARGIN_MAX=1.80
ENABLE_DERIBIT_IV=true
DERIBIT_IV_WEIGHT=0.60
DERIBIT_MIN_DTE_HOURS=6.0

# Position exit
ENABLE_POSITION_EXIT=true
EXIT_LOSS_TRIGGER=0.40
TAKE_PROFIT_TRIGGER=2.0
TAKE_PROFIT_MIN_HOURS=0.5

# Smart order placement (maker-first, cancel instead of crossing the ask)
ENABLE_MAKER_ORDERS=true
MAKER_ORDER_TIMEOUT_SEC=120
ENABLE_PRICE_IMPROVEMENT=true
PRICE_IMPROVEMENT_TIMEOUT_SEC=90
MAKER_ENTRY_TIMEOUT_SEC=30
STALE_ORDER_POLL_SEC=10
STALE_ORDER_SPOT_MOVE_PCT=0.003

# Slippage-adjusted sizing
SLIPPAGE_ADJUSTMENT_MIN_TRADES=10
SLIPPAGE_ADJUSTMENT_LOOKBACK_DAYS=14

# Graduated drawdown
DRAWDOWN_TIER_1_PCT=0.10
DRAWDOWN_TIER_1_SCALE=0.50
DRAWDOWN_TIER_2_PCT=0.15
DRAWDOWN_TIER_2_SCALE=0.25

# Monitoring (Slack/Discord webhook; leave empty for log-only)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_MIN_LEVEL=WARNING
ALERT_DEDUP_SECONDS=900

# Execution
POLL_INTERVAL_SECONDS=60
DRY_RUN=false
FORCE_TRADING_HOURS=false
