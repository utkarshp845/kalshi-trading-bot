# Kalshi Bot — environment file
#
# Philosophy: keep this file minimal. Every variable below has a code default
# in bot/config.py, and pinning a value here means it silently overrides that
# default forever — including future tuning changes to config.py that you'd
# otherwise get for free. Config drift between this file and config.py has
# caused real production confusion before (see README "Lessons Learned").
#
# Only three categories belong here:
#   1. Credentials / connection info (genuinely machine-specific)
#   2. Mode switches you want explicit (trading mode, enabled assets)
#   3. Deliberate, documented deviations from a code default
#
# Everything else: leave it out and let bot/config.py's default win. The
# commented reference block at the bottom shows every tunable and its current
# code default, for visibility — uncomment only what you intend to override.

# --- Credentials / connection (required) ---
KALSHI_API_KEY_ID=your-api-key-id-here
KALSHI_PRIVATE_KEY_PATH=./bitcoin-key.pem
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# --- Mode ---
TRADING_MODE=observe
DRY_RUN=false
ENABLE_BTC=true
ENABLE_ETH=true

# --- Monitoring ---
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_MIN_LEVEL=WARNING

# --- Deliberate deviations from code defaults (uncomment to use) ---
# LIVE_HALT_MAX_AVG_REALIZED_EDGE=-0.05

# =====================================================================
# Reference: every other tunable and its current bot/config.py default.
# Uncomment a line only if you intend to permanently override it here.
# =====================================================================

